#!/usr/bin/python3
"""Captar - captura de tela com anotações."""

import os
import sys

# O .deb traz o PySide6 embutido em /usr/share/captar/lib.
if os.path.isdir("/usr/share/captar/lib/PySide6"):
    sys.path.insert(0, "/usr/share/captar/lib")

# Quando instalado por pacote, o código fica em /usr/share/captar.
_here = os.path.dirname(os.path.realpath(__file__))
for _candidate in ("/usr/share/captar", os.path.join(_here, "..")):
    _candidate = os.path.abspath(_candidate)
    if os.path.isdir(os.path.join(_candidate, "captar")):
        sys.path.insert(0, _candidate)
        break

from captar.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
